VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Stripe Checkout (requires Supabase Edge Functions — see SETUP.md)
# VITE_USE_STRIPE_CHECKOUT=true

# Optional: station webpage (new tab) and direct HTTPS stream (played in the header while you stay on Bazodeal)
# VITE_RADIO_STATION_URL=https://www.radio-trinidad.com/hott-93
# VITE_RADIO_STREAM_URL=https://ice41.securenetsystems.net/HOTT93

# Autoplay after load (many browsers require a tap first anyway). Set to false to start only when user taps Listen
# VITE_RADIO_AUTOPLAY=false
