VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Deal Sourcer — set to false to skip same-origin /api/deal-sourcer-scan fallback (Vercel)
# VITE_DEAL_SOURCER_PROXY=false

# Optional: Stripe Checkout (requires Supabase Edge Functions — see SETUP.md)
# VITE_USE_STRIPE_CHECKOUT=true

# Optional: station webpage (new tab) and direct HTTPS stream (played in the header while you stay on Bazodeal)
# VITE_RADIO_STATION_URL=https://www.radio-trinidad.com/hott-93
# VITE_RADIO_STREAM_URL=https://ice41.securenetsystems.net/HOTT93

# Merchant QR signup → WhatsApp welcome (Supabase Edge Function merchant-welcome-whatsapp + Twilio WhatsApp)
# Deploy: supabase functions deploy merchant-welcome-whatsapp
# Secrets in Supabase: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, TWILIO_WHATSAPP_FROM (format: whatsapp:+14155238886)
# Vercel same-origin proxy (like Deal Sourcer). Set false only if you never use /api/merchant-welcome-whatsapp
# VITE_MERCHANT_WHATSAPP_PROXY=true

# Autoplay after load (many browsers require a tap first anyway). Set to false to start only when user taps Listen
# VITE_RADIO_AUTOPLAY=false
